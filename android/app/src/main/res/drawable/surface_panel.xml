<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="@dimen/corner_xlarge"
                android:topRightRadius="@dimen/corner_xlarge" />
            <solid android:color="@color/royal_gold" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="@dimen/corner_xlarge"
                android:topRightRadius="@dimen/corner_xlarge" />
            <gradient
                android:angle="270"
                android:startColor="@color/surface_paper"
                android:endColor="@color/surface_sunk"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
