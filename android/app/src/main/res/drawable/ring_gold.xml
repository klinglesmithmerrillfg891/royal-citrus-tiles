<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerColor="#33F0D98A"
                android:endColor="#00FFF8E1"
                android:gradientRadius="70dp"
                android:startColor="#66FFF8E1"
                android:type="radial" />
            <stroke
                android:width="@dimen/stroke_frame"
                android:color="@color/royal_gold" />
        </shape>
    </item>
</layer-list>
