<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/citrus_cream">

    <ImageView
        android:id="@+id/game_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_game"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/game_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/scrim_game"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/game_header"
        android:layout_width="0dp"
        android:layout_height="@dimen/header_height"
        android:background="@drawable/surface_header"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/game_back_button"
        style="@style/Widget.App.Button.Icon"
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/header_padding_top"
        android:contentDescription="@string/desc_back"
        app:icon="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/game_wing_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginTop="@dimen/header_padding_top"
        android:layout_marginEnd="@dimen/gutter"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/stat_placeholder_label"
        android:textAppearance="@style/TextAppearance.App.Title"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/game_moves_pill"
        app:layout_constraintStart_toEndOf="@id/game_back_button"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/game_wing_position"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/stat_placeholder_label"
        android:textAppearance="@style/TextAppearance.App.Label"
        android:textSize="@dimen/text_micro"
        app:layout_constraintEnd_toEndOf="@id/game_wing_name"
        app:layout_constraintStart_toStartOf="@id/game_wing_name"
        app:layout_constraintTop_toBottomOf="@id/game_wing_name" />

    <LinearLayout
        android:id="@+id/game_moves_pill"
        android:layout_width="@dimen/moves_pill_width"
        android:layout_height="@dimen/moves_pill_height"
        android:layout_marginTop="@dimen/header_padding_top"
        android:layout_marginEnd="@dimen/screen_margin"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/pill_moves"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/game_moves_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/game_moves_label"
            android:textAppearance="@style/TextAppearance.App.Label"
            android:textSize="@dimen/text_micro" />

        <TextView
            android:id="@+id/game_moves_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stat_placeholder_value"
            android:textAppearance="@style/TextAppearance.App.Numeric"
            android:textColor="@color/citrus_orange"
            android:textSize="@dimen/text_cta_small" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/game_board_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/game_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/game_header">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/game_board_frame"
            android:layout_width="@dimen/board_max_width"
            android:layout_height="@dimen/board_max_width"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/surface_board"
            app:cardCornerRadius="@dimen/corner_large"
            app:cardElevation="@dimen/elevation_board"
            app:contentPadding="@dimen/board_frame_padding"
            app:strokeColor="@color/royal_gold"
            app:strokeWidth="@dimen/stroke_frame">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/board_inner_engrave">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/game_board_recycler"
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never" />

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/game_error_block"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/game_error_icon"
                android:layout_width="@dimen/icon_decor"
                android:layout_height="@dimen/icon_decor"
                android:alpha="0.4"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_leaf_sprig" />

            <TextView
                android:id="@+id/game_error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gutter"
                android:text="@string/game_board_error"
                android:textAppearance="@style/TextAppearance.App.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/game_error_retry"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height_secondary"
                android:layout_marginTop="@dimen/screen_margin"
                android:text="@string/game_try_again" />

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/game_panel"
        android:layout_width="0dp"
        android:layout_height="@dimen/panel_height"
        android:background="@drawable/surface_panel"
        android:elevation="@dimen/elevation_panel"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/gutter_small"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/nav_bar_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/game_stat_strip"
            android:layout_width="match_parent"
            android:layout_height="@dimen/stat_strip_height"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:orientation="horizontal">

            <com.royalcitrustiles.puzzle.core.ui.StatCardView
                android:id="@+id/game_stat_score"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.royalcitrustiles.puzzle.core.ui.StatCardView
                android:id="@+id/game_stat_combo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/gutter_small"
                android:layout_weight="1" />

            <com.royalcitrustiles.puzzle.core.ui.StatCardView
                android:id="@+id/game_stat_crowns"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/gutter_small"
                android:layout_weight="1" />

        </LinearLayout>

        <com.royalcitrustiles.puzzle.core.ui.OrderProgressView
            android:id="@+id/game_order_progress"
            android:layout_width="match_parent"
            android:layout_height="@dimen/order_strip_height"
            android:layout_marginTop="@dimen/gutter_small"
            android:accessibilityLiveRegion="polite" />

        <LinearLayout
            android:id="@+id/game_action_row"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_primary"
            android:layout_marginTop="@dimen/gutter"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/game_crown_button"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/game_use_crown"
                android:textSize="@dimen/text_body_small"
                app:icon="@drawable/ic_crown_mark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/game_deliver_button"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/gutter"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/game_deliver" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
